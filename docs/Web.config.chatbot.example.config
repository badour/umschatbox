<?xml version="1.0"?>
<!--
  Copy these entries into the existing Web.config.
  Replace the connection string and stored procedure names if your app already uses different names.
-->
<configuration>
  <connectionStrings>
    <add name="ExpensesDb"
         connectionString="Data Source=YOUR_SQL_SERVER;Initial Catalog=YOUR_EXPENSES_DB;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Optional: point the chatbot to an existing connection string name. -->
    <add key="ExpenseChatbot.ConnectionStringName" value="ExpensesDb" />

    <!-- Optional limits. -->
    <add key="ExpenseChatbot.CommandTimeoutSeconds" value="30" />
    <add key="ExpenseChatbot.MaxRows" value="50" />
    <add key="ExpenseChatbot.IntentConfidenceThreshold" value="0.35" />

    <!-- Optional stored procedure overrides. -->
    <add key="ExpenseChatbot.FileLinks.StoredProcedure" value="dbo.Chatbot_GetFileLinks" />
    <add key="ExpenseChatbot.FileLinks.ParameterName" value="@SearchText" />

    <add key="ExpenseChatbot.InvoiceExpenseCode.StoredProcedure" value="dbo.Chatbot_GetInvoiceExpenseCodes" />
    <add key="ExpenseChatbot.InvoiceExpenseCode.ParameterName" value="@InvoiceNumber" />

    <add key="ExpenseChatbot.PersonExpenses.StoredProcedure" value="dbo.Chatbot_GetPersonExpenses" />
    <add key="ExpenseChatbot.PersonExpenses.ParameterName" value="@PersonName" />
  </appSettings>
</configuration>
